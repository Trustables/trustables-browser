{
  "name": "@trustables/browser",
  "version": "0.2.0",
  "type": "module",
  "description": "Framework-independent d-you wallet verification widget for Trustables",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/*": "./dist/*",
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "assets",
    "README.md"
  ],
  "scripts": {
    "build": "node tools/build.mjs && tsc",
    "test": "npm run build && node --test tests/unit.mjs && node tests/browser.mjs && node tests/install.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trustables/trustables-browser.git"
  },
  "homepage": "https://docs.dev.trustables.de/guides/browser-widget/",
  "bugs": {
    "url": "https://github.com/Trustables/trustables-browser/issues"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
